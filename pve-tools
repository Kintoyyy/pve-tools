#!/usr/bin/env bash
# pve-tools — a whiptail TUI toolkit for Proxmox VE 7, 8 and 9.
# https://github.com/Kintoyyy/pve-tools
set -uo pipefail

PVE_TOOLS_VERSION="0.1.0"
PVE_TOOLS_REPO="${PVE_TOOLS_REPO:-Kintoyyy/pve-tools}"
PVE_TOOLS_REF="${PVE_TOOLS_REF:-main}"
PVE_TOOLS_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

# shellcheck source=lib/common.sh
source "$PVE_TOOLS_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$PVE_TOOLS_DIR/lib/ui.sh"
# shellcheck source=modules/postinstall.sh
source "$PVE_TOOLS_DIR/modules/postinstall.sh"
# shellcheck source=modules/guests.sh
source "$PVE_TOOLS_DIR/modules/guests.sh"
# shellcheck source=modules/backup.sh
source "$PVE_TOOLS_DIR/modules/backup.sh"
# shellcheck source=modules/maintenance.sh
source "$PVE_TOOLS_DIR/modules/maintenance.sh"

usage() {
  cat <<EOF
pve-tools $PVE_TOOLS_VERSION — TUI toolkit for Proxmox VE

Usage: pve-tools [--dry-run] [command]

Commands:
  (none)       Open the interactive menu
  update       Update pve-tools to the latest version
  uninstall    Remove pve-tools from this host
  version      Print the version
  help         Show this help

Options:
  --dry-run    Show the commands that would change the system without running them
EOF
}

# Download the latest installer and run it.
run_installer() {
  local tmp="$PVE_TOOLS_TMP/install.sh"
  local url="https://raw.githubusercontent.com/$PVE_TOOLS_REPO/$PVE_TOOLS_REF/install.sh"
  msg_info "Downloading installer from $url"
  curl -fsSL "$url" -o "$tmp" || { msg_error "Download failed."; return 1; }
  run env PVE_TOOLS_REPO="$PVE_TOOLS_REPO" PVE_TOOLS_REF="$PVE_TOOLS_REF" bash "$tmp"
}

self_update() {
  ui_terminal "Update pve-tools"
  if run_installer && ! is_dry_run; then
    msg_ok "Update complete. Restarting pve-tools..."
    sleep 1
    rm -rf "$PVE_TOOLS_TMP" # exec skips the EXIT trap
    exec /usr/local/bin/pve-tools
  fi
  pause
}

main_menu() {
  local choice
  UI_BACKTITLE="pve-tools $PVE_TOOLS_VERSION  |  Proxmox VE $PVE_VERSION on $PVE_NODE"
  is_dry_run && UI_BACKTITLE+="  |  DRY-RUN"

  while true; do
    choice=$(ui_menu "Main menu" "Choose a category:" \
      postinstall "Post-install setup (repos, nag, upgrade)" \
      guests      "VM / LXC management" \
      backup      "Backups & snapshots" \
      maint       "System maintenance" \
      update      "Update pve-tools" \
      exit        "Exit") || break
    case $choice in
      postinstall) postinstall_menu ;;
      guests)      guests_menu ;;
      backup)      backup_menu ;;
      maint)       maintenance_menu ;;
      update)      self_update ;;
      exit)        break ;;
    esac
  done
  clear
}

main() {
  local cmd=tui
  while (($#)); do
    case $1 in
      --dry-run)            PVE_TOOLS_DRY_RUN=1 ;;
      -h | --help | help)   usage; exit 0 ;;
      -v | --version | version) echo "$PVE_TOOLS_VERSION"; exit 0 ;;
      update | uninstall)   cmd=$1 ;;
      *)                    usage >&2; die "Unknown argument: $1" ;;
    esac
    shift
  done

  require_root
  require_pve
  detect_pve

  PVE_TOOLS_TMP=$(mktemp -d /tmp/pve-tools.XXXXXX)
  trap 'rm -rf "$PVE_TOOLS_TMP"' EXIT

  case $cmd in
    update)    run_installer ;;
    uninstall) run bash "$PVE_TOOLS_DIR/install.sh" --uninstall ;;
    tui)       main_menu ;;
  esac
}

main "$@"
